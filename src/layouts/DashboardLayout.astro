---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Verdant Portal" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-zinc-950 text-zinc-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased bg-zinc-950 text-zinc-100 flex flex-col min-h-screen">
    <header class="border-b border-zinc-800/80 bg-zinc-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/dashboard" class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-600 to-emerald-500 flex items-center justify-center font-bold text-white text-sm shadow-md">
            V
          </div>
          <div>
            <span class="font-bold text-base tracking-tight text-white block leading-none">Verdant</span>
            <span class="text-[10px] uppercase tracking-widest text-emerald-400 font-mono">Portal</span>
          </div>
        </a>

        <nav class="flex items-center gap-6 text-sm font-medium text-zinc-400">
          <a href="/dashboard" class="hover:text-blue-400 transition-colors">Overview</a>
          <a href="/dashboard/settings" class="hover:text-blue-400 transition-colors">Settings</a>
          <form action="/api/logout" method="POST" class="inline m-0">
            <button type="submit" class="text-zinc-400 hover:text-red-400 text-sm font-medium transition-colors cursor-pointer">
              Sign Out
            </button>
          </form>
        </nav>
      </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-10">
      <slot />
    </main>

    <footer class="border-t border-zinc-800/60 py-6 text-center text-xs text-zinc-500 font-mono">
      Verdant Portal // Tier 3 Custom App // Viewport Digital LLC
    </footer>
  </body>
</html>
